# Not secret — EXPO_PUBLIC_* vars are inlined into the client bundle by design.
#
# Only needed to override the built-in default (see src/config.ts), which
# already handles the iOS simulator and Android emulator. Set this when
# testing on a physical device over Wi-Fi: use your machine's LAN IP, not
# "localhost" — a phone on the same network can't resolve your laptop's
# localhost to itself.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api

# Needed for live sync (Supabase Realtime). Same project as apps/web/apps/api
# — the anon/publishable key, safe client-side. Without these, the app still
# works fully, it just falls back to periodic polling instead of live pushes.
# EXPO_PUBLIC_SUPABASE_URL=https://lcwqvrnqzchhorzxrpjl.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_R49IVywQrxY7_7K05nzvwg_REXnGMc9
