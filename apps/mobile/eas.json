{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://herai-web-kappa.vercel.app/api",
        "EXPO_PUBLIC_AI_SERVICE_URL": "https://herai-web-kappa.vercel.app/ai"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://herai-web-kappa.vercel.app/api",
        "EXPO_PUBLIC_AI_SERVICE_URL": "https://herai-web-kappa.vercel.app/ai"
      }
    }
  }
}
