{
  "expo": {
    "name": "Lunee",
    "slug": "lunee",
    "scheme": "lunee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fdf2f8",
    "splash": {
      "backgroundColor": "#fdf2f8",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lunee.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Lunee uses Face ID to unlock the app and keep your health data private."
      }
    },
    "android": {
      "package": "com.lunee.app",
      "adaptiveIcon": {
        "backgroundColor": "#fdf2f8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lunee uses your location to show labs and doctors near you."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lunee uses Face ID to unlock the app and keep your health data private."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d12468"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "ed712767-e450-4e49-8762-4c5c76c1618b"
      }
    },
    "owner": "aryanjohar7",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed712767-e450-4e49-8762-4c5c76c1618b"
    }
  }
}
