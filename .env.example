# --- General ---
DEMO_MODE=true
NODE_ENV=development

# --- apps/api ---
PORT=4000
# Comma-separated. Only matters for browser-based clients (apps/web, `expo
# start --web`) — native iOS/Android builds never hit browser CORS.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Supabase project — get these from your project's dashboard (Settings > API).
# SUPABASE_SERVICE_ROLE_KEY is server-only: never ship it to apps/web or
# apps/mobile. Clients never call Supabase directly — they call this
# gateway's /api/auth/* and store the returned session tokens themselves.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key — used only to sign users in (see createAuthClient in
# apps/api/src/config/supabase.ts), never for data access.
SUPABASE_ANON_KEY=

# --- apps/ai-service ---
AI_SERVICE_PORT=8000

# LLM provider abstraction (apps/ai-service/app/llm/): every agent talks to
# the LLMProvider interface (generate / generate_stream / analyze_image /
# embed) in app/llm/base.py, never to a vendor SDK directly.
#
# DEMO_MODE=true always wins and forces MockLLMProvider (app/llm/mock_provider.py),
# which returns plausible, varied, schema-shaped JSON per agent with zero API
# calls and zero cost — this is what the whole agent pipeline runs on today.
#
# To run on a real model, set DEMO_MODE=false and pick a provider:
#
#   gemini     (app/llm/gemini_provider.py)    — cheapest, has a free tier.
#              LLM_MODEL=gemini-2.5-flash
#              Key: https://aistudio.google.com/apikey
#   anthropic  (app/llm/anthropic_provider.py) — strongest reasoning, paid.
#              LLM_MODEL=claude-sonnet-5
#
# Nothing in app/agents/ or app/orchestrator.py changes either way. To add a
# vendor: implement app/llm/<name>_provider.py and register it in factory.py.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Embeddings are NOT served by Anthropic, so app/llm/embeddings.py runs
# BGE-small locally via ONNX: no per-query cost, and health queries are never
# sent anywhere to be vectorized. The model (~130MB) downloads on first use.
#
# Each provider's embeddings live in their own vector space, so the knowledge
# index is per-space (knowledge_index.<space>.json) and so is the similarity
# threshold. After changing embedding provider OR editing knowledge/*.json:
#   .venv/Scripts/python.exe scripts/ingest_knowledge.py   # rebuild index
#   .venv/Scripts/python.exe scripts/tune_threshold.py     # re-measure cutoff
# Then update MIN_SIMILARITY_BY_SPACE in app/knowledge/store.py.

# Agent prompts/results contain the user's symptoms, conditions, medications
# and free-text query. Leave false in any environment with real users — true
# writes that health data to plaintext logs. Synthetic data only.
LOG_HEALTH_DATA=false
